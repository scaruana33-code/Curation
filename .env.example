# Copy to .env (never commit .env). Set these as secrets in your host.
NODE_ENV=production
BASE_URL=https://your-app.example.com
SESSION_SECRET=generate-with-openssl-rand-hex-32
APPROVERS=scaruana33@gmail.com,admin@nomorereportsontherun.com,rharrington758@gmail.com
APPROVAL_HOURS=48
DB_PATH=/data/app.db

# Agent (Claude API with web search)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (SMTP URL, e.g. smtps://user:pass@smtp.provider.com:465)
SMTP_URL=
MAIL_FROM=LinkedIn Content Automation <no-reply@your-domain.com>

# LinkedIn: stays dry-run until you set live AND provide both values
PUBLISH_MODE=dry-run
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:
